# ---- Site ----
NEXT_PUBLIC_SITE_URL=https://speedyscashforcars.com
NEXT_PUBLIC_SITE_NAME="Speedy's Cash For Cars"
NEXT_PUBLIC_PHONE="1-800-SPEEDY-1"
NEXT_PUBLIC_EMAIL="quote@speedyscashforcars.com"

# ---- Zoho Sheet public CSV URL ----
# In Zoho Sheet: File > Publish > Publish to web > CSV. Paste the public URL here.
ZOHO_LOCATIONS_CSV_URL="https://sheet.zoho.com/publish/csv/EXAMPLE"

# ---- Admin refresh ----
# Used to gate /admin and the /api/refresh endpoint.
# Set to a long random string in Vercel project settings.
ADMIN_REFRESH_SECRET="change-me-to-a-long-random-string"

# ---- Service-area radius ----
# Cities within this many miles of any physical yard also get a service-area page
# (merged with the top-US-cities list, deduplicated).
SERVICE_AREA_RADIUS_MILES=75
